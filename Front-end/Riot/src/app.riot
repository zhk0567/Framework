<app>
  <div class="shell">
    <h1>Riot.js 能力展台</h1>
    <p class="lead muted">
      轻量组件化：<strong>.riot</strong> 单文件组件、<code>state</code> 与 <code>this.update</code>。
    </p>
    <ul class="tag-list">
      <li each={ t in state.tags }>{ t }</li>
    </ul>
    <section class="panel">
      <h2>状态</h2>
      <p class="lead">计数：{ state.count }</p>
      <div class="row">
        <button type="button" onclick={ inc }>+1</button>
      </div>
    </section>
    <section class="panel">
      <h2>列表</h2>
      <div class="row">
        <input
          type="text"
          value={ state.draft }
          oninput={ onDraft }
          placeholder="新条目"
        />
        <button type="button" class="secondary" onclick={ add }>添加</button>
      </div>
      <ul>
        <li each={ x in state.items }>{ x }</li>
      </ul>
    </section>
  </div>
  <script>
    export default {
      state: {
        count: 0,
        draft: '',
        items: ['示例项'],
        tags: ['Riot 9', 'rollup-plugin-riot', 'Vite 8', 'TS'],
      },
      inc() {
        this.update({ count: this.state.count + 1 });
      },
      onDraft(e) {
        this.update({ draft: e.target.value });
      },
      add() {
        const t = this.state.draft.trim();
        if (!t) return;
        this.update({
          items: [t, ...this.state.items],
          draft: '',
        });
      },
    };
  </script>
</app>
